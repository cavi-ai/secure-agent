{
  "PreToolUse": [
    {
      "matcher": {
        "tool_name": "Bash"
      },
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${plugin_dir}/hooks/secret_guard.py"
        }
      ]
    },
    {
      "matcher": {
        "tool_name": "Read|Grep|Glob|Write|Edit|MultiEdit|NotebookEdit"
      },
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${plugin_dir}/hooks/secret_guard.py"
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": {
        "tool_name": ".*"
      },
      "hooks": [
        {
          "type": "command",
          "command": "python3 ${plugin_dir}/hooks/injection_scan.py"
        },
        {
          "type": "command",
          "command": "python3 ${plugin_dir}/hooks/activity_log.py"
        }
      ]
    }
  ]
}
