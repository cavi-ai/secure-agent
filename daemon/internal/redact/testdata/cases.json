{
  "secrets": [
    {"name": "bearer header", "before": "curl -H 'Authorization: Bearer ", "prefix": "", "fill": "t", "n": 24, "after": "' https://api.example.com"},
    {"name": "lowercase bearer header", "before": "curl -H 'authorization: bearer ", "prefix": "", "fill": "t", "n": 24, "after": "'"},
    {"name": "bearer after token key", "before": "token: Bearer ", "prefix": "", "fill": "u", "n": 24, "after": ""},
    {"name": "jwt", "before": "jwt ", "prefix": "eyJa.eyJb.", "fill": "c", "n": 20, "after": " end"},
    {"name": "aws access key id", "before": "key ", "prefix": "AKIA", "fill": "Q", "n": 16, "after": " end"},
    {"name": "anthropic key", "before": "echo ", "prefix": "sk-ant-api03-", "fill": "a", "n": 30, "after": ""},
    {"name": "openai key", "before": "echo ", "prefix": "sk-proj-", "fill": "b", "n": 24, "after": ""},
    {"name": "github token", "before": "echo ", "prefix": "ghp_", "fill": "d", "n": 36, "after": ""},
    {"name": "github token after CJK text", "before": "令牌", "prefix": "ghp_", "fill": "d", "n": 36, "after": ""},
    {"name": "gitlab token", "before": "echo ", "prefix": "glpat-", "fill": "e", "n": 20, "after": ""},
    {"name": "slack token", "before": "echo ", "prefix": "xoxb-", "fill": "1", "n": 24, "after": ""},
    {"name": "url userinfo", "before": "git clone https://user:", "prefix": "", "fill": "p", "n": 16, "after": "@example.com/repo.git"},
    {"name": "url userinfo with slash", "before": "git clone https://user:", "prefix": "pa/", "fill": "p", "n": 16, "after": "@example.com/repo.git"},
    {"name": "password flag", "before": "mysql -u root --password ", "prefix": "", "fill": "q", "n": 12, "after": " db"},
    {"name": "keychain -w flag", "before": "security add-generic-password -s svc -a me -w ", "prefix": "", "fill": "h", "n": 14, "after": ""},
    {"name": "api key assignment", "before": "export API_KEY=", "prefix": "", "fill": "z", "n": 20, "after": ""},
    {"name": "prefixed token assignment", "before": "export GITHUB_TOKEN=", "prefix": "", "fill": "z", "n": 20, "after": ""},
    {"name": "prefixed api key assignment", "before": "export OPENAI_API_KEY=", "prefix": "", "fill": "z", "n": 20, "after": ""},
    {"name": "prefixed secret key assignment", "before": "export STRIPE_SECRET_KEY=", "prefix": "", "fill": "z", "n": 20, "after": ""},
    {"name": "value starting with a bracket", "before": "export PASSWORD=[", "prefix": "", "fill": "y", "n": 12, "after": ""},
    {"name": "quoted password", "before": "password: \"", "prefix": "", "fill": "y", "n": 12, "after": "\""},
    {"name": "aws secret assignment", "before": "export AWS_SECRET_ACCESS_KEY=", "prefix": "", "fill": "w", "n": 40, "after": ""},
    {"name": "private key body", "pem": "OPENSSH", "before": "", "prefix": "", "fill": "k", "n": 40, "after": ""}
  ],
  "exact": [
    {"name": "word-count flag keeps its path", "in": "wc -w ~/.aws/credentials", "want": "wc -w ~/.aws/credentials"},
    {"name": "rsync -W keeps its path", "in": "rsync -W ~/.ssh/id_rsa backup:/tmp/", "want": "rsync -W ~/.ssh/id_rsa backup:/tmp/"},
    {"name": "-w outside security does not consume --password", "in": "mysql -w --password hunter2hunter2 db", "want": "mysql -w --password [REDACTED] db"},
    {"name": "security -w value", "in": "security add-generic-password -s svc -a me -w hunter2hunter2", "want": "security add-generic-password -s svc -a me -w [REDACTED]"},
    {"name": "security -w as a bare flag", "in": "security find-generic-password -s svc -w", "want": "security find-generic-password -s svc -w"},
    {"name": "password flag before another flag", "in": "mysql --password -h db.example.com", "want": "mysql --password -h db.example.com"},
    {"name": "existing mask after password flag", "in": "mysql --password [REDACTED:db-conn-string] db", "want": "mysql --password [REDACTED:db-conn-string] db"},
    {"name": "existing mask in assignment", "in": "TOKEN=[REDACTED:fp1] ok", "want": "TOKEN=[REDACTED:fp1] ok"},
    {"name": "quoted existing mask", "in": "password: \"[REDACTED:fp1]\"", "want": "password: \"[REDACTED:fp1]\""},
    {"name": "existing mask inside JSON", "in": "{\"output\":\"TOKEN=[REDACTED:fp1]\"}", "want": "{\"output\":\"TOKEN=[REDACTED:fp1]\"}"},
    {"name": "text after an existing mask", "in": "TOKEN=[REDACTED]hunter2hunter2", "want": "TOKEN=[REDACTED]"},
    {"name": "existing mask in url userinfo", "in": "https://user:[REDACTED:fp1]@example.com", "want": "https://user:[REDACTED:fp1]@example.com"},
    {"name": "host port path with at sign", "in": "http://localhost:8080/path@v2", "want": "http://localhost:8080/path@v2"},
    {"name": "bracketed value is not a mask", "in": "export PASSWORD=[hunter2hunter2", "want": "export PASSWORD=[REDACTED]"},
    {"name": "url password with slash", "in": "git clone https://user:pa/ssword@example.com/r.git", "want": "git clone https://[REDACTED]@example.com/r.git"},
    {"name": "prefixed password", "in": "export DB_PASSWORD=hunter2hunter2", "want": "export DB_PASSWORD=[REDACTED]"},
    {"name": "bearer value after token key", "in": "token: Bearer xyzxyzxyz", "want": "token: [REDACTED] [REDACTED]"}
  ]
}
