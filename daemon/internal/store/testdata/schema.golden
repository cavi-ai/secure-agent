index idx_decision_scope_match: CREATE INDEX idx_decision_scope_match ON decision_scopes(agent,rule_id,operation)
index idx_egress_episodes_last: CREATE INDEX idx_egress_episodes_last ON egress_episodes(last_seen_ns DESC, id)
index idx_events_call: CREATE UNIQUE INDEX idx_events_call ON events(session_id, call_id)
index idx_events_host: CREATE INDEX idx_events_host ON events(remote_host, id, ts) WHERE remote_host != ''
index idx_events_kind_id: CREATE INDEX idx_events_kind_id ON events(kind, id)
index idx_events_pid_ts: CREATE INDEX idx_events_pid_ts ON events(pid, ts)
index idx_events_record: CREATE INDEX idx_events_record ON events(kind, id) WHERE record = 1
index idx_events_session_activity: CREATE INDEX idx_events_session_activity ON events(session_id, kind, (strftime('%Y-%m-%dT%H:%M:%S',substr(ts,1,19)||substr(ts,-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)))||'.'||substr((CASE WHEN instr(ts,'.')>0 THEN substr(ts,instr(ts,'.')+1,length(ts)-instr(ts,'.')-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9)||'Z'), ts) WHERE kind IN (8, 9, 12, 13, 14)
index idx_events_session_kind_id: CREATE INDEX idx_events_session_kind_id ON events(session_id, kind, id)
index idx_events_session_time: CREATE INDEX idx_events_session_time ON events(session_id, (strftime('%Y-%m-%dT%H:%M:%S',substr(ts,1,19)||substr(ts,-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)))||'.'||substr((CASE WHEN instr(ts,'.')>0 THEN substr(ts,instr(ts,'.')+1,length(ts)-instr(ts,'.')-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9)||'Z'), id)
index idx_events_trace_activity: CREATE INDEX idx_events_trace_activity ON events(kind, (strftime('%Y-%m-%dT%H:%M:%S',substr(ts,1,19)||substr(ts,-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)))||'.'||substr((CASE WHEN instr(ts,'.')>0 THEN substr(ts,instr(ts,'.')+1,length(ts)-instr(ts,'.')-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9)||'Z'), session_id, ts) WHERE kind IN (8, 12, 13, 14)
index idx_events_turn_dedupe: CREATE UNIQUE INDEX idx_events_turn_dedupe ON events(kind,session_id,ts) WHERE kind=13 AND session_id!=''
index idx_expected_egress_match: CREATE INDEX idx_expected_egress_match ON expected_egress_rules(agent,kind,revoked_at)
index idx_finding_review_members_review: CREATE INDEX idx_finding_review_members_review ON finding_review_members(review_id,last_seen)
index idx_finding_reviews_session: CREATE INDEX idx_finding_reviews_session ON finding_reviews(session_id)
index idx_finding_reviews_state: CREATE INDEX idx_finding_reviews_state ON finding_reviews(state,last_seen,id)
index idx_flags_instant_time: CREATE INDEX idx_flags_instant_time ON flags((strftime('%Y-%m-%dT%H:%M:%S',substr(ts,1,19)||substr(ts,-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)))||'.'||substr((CASE WHEN instr(ts,'.')>0 THEN substr(ts,instr(ts,'.')+1,length(ts)-instr(ts,'.')-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9)||'Z'), id)
index idx_flags_pid: CREATE INDEX idx_flags_pid ON flags(pid)
index idx_flags_rule_agent: CREATE INDEX idx_flags_rule_agent ON flags(rule, agent)
index idx_guard_decisions_session_at: CREATE INDEX idx_guard_decisions_session_at ON guard_decisions(session_id, at, id)
index idx_hook_runs_session_time: CREATE INDEX idx_hook_runs_session_time ON hook_runs(session_id, (strftime('%Y-%m-%dT%H:%M:%S',substr(ts,1,19)||substr(ts,-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)))||'.'||substr((CASE WHEN instr(ts,'.')>0 THEN substr(ts,instr(ts,'.')+1,length(ts)-instr(ts,'.')-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9)||'Z') DESC, run_id DESC)
index idx_incidents_flag: CREATE INDEX idx_incidents_flag ON incidents(flag_id)
index idx_incidents_instant_time: CREATE INDEX idx_incidents_instant_time ON incidents((strftime('%Y-%m-%dT%H:%M:%S',substr(created_at,1,19)||substr(created_at,-(CASE WHEN substr(created_at,-1)='Z' THEN 1 ELSE 6 END)))||'.'||substr((CASE WHEN instr(created_at,'.')>0 THEN substr(created_at,instr(created_at,'.')+1,length(created_at)-instr(created_at,'.')-(CASE WHEN substr(created_at,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9)||'Z'), id)
index idx_incidents_open_key: CREATE INDEX idx_incidents_open_key ON incidents(COALESCE(rule,''), COALESCE(session_id,''), COALESCE(subject,''))
index idx_interventions_session: CREATE INDEX idx_interventions_session ON interventions(session_id,requested_at)
index idx_memory_events: CREATE INDEX idx_memory_events ON events(session_id, (CAST(strftime('%s',substr(ts,1,19)||substr(ts,-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END))) AS INTEGER)*1000000000 + CAST(substr((CASE WHEN instr(ts,'.')>0 THEN substr(ts,instr(ts,'.')+1,length(ts)-instr(ts,'.')-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9) AS INTEGER)), CAST(id AS TEXT))
index idx_memory_flags: CREATE INDEX idx_memory_flags ON flags(session_id, (CAST(strftime('%s',substr(ts,1,19)||substr(ts,-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END))) AS INTEGER)*1000000000 + CAST(substr((CASE WHEN instr(ts,'.')>0 THEN substr(ts,instr(ts,'.')+1,length(ts)-instr(ts,'.')-(CASE WHEN substr(ts,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9) AS INTEGER)), CAST(id AS TEXT))
index idx_memory_guards: CREATE INDEX idx_memory_guards ON guard_decisions(session_id, (CAST(strftime('%s',substr(at,1,19)||substr(at,-(CASE WHEN substr(at,-1)='Z' THEN 1 ELSE 6 END))) AS INTEGER)*1000000000 + CAST(substr((CASE WHEN instr(at,'.')>0 THEN substr(at,instr(at,'.')+1,length(at)-instr(at,'.')-(CASE WHEN substr(at,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9) AS INTEGER)), CAST(id AS TEXT))
index idx_memory_incidents: CREATE INDEX idx_memory_incidents ON incidents(session_id, (CAST(strftime('%s',substr(created_at,1,19)||substr(created_at,-(CASE WHEN substr(created_at,-1)='Z' THEN 1 ELSE 6 END))) AS INTEGER)*1000000000 + CAST(substr((CASE WHEN instr(created_at,'.')>0 THEN substr(created_at,instr(created_at,'.')+1,length(created_at)-instr(created_at,'.')-(CASE WHEN substr(created_at,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9) AS INTEGER)), CAST(id AS TEXT))
index idx_memory_resource_families: CREATE INDEX idx_memory_resource_families ON resource_episodes(session_key, (CAST(strftime('%s',substr(captured_at,1,19)||substr(captured_at,-(CASE WHEN substr(captured_at,-1)='Z' THEN 1 ELSE 6 END))) AS INTEGER)*1000000000 + CAST(substr((CASE WHEN instr(captured_at,'.')>0 THEN substr(captured_at,instr(captured_at,'.')+1,length(captured_at)-instr(captured_at,'.')-(CASE WHEN substr(captured_at,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9) AS INTEGER)), CAST(id AS TEXT))
index idx_memory_resources: CREATE INDEX idx_memory_resources ON resource_episodes(session_id, (CAST(strftime('%s',substr(captured_at,1,19)||substr(captured_at,-(CASE WHEN substr(captured_at,-1)='Z' THEN 1 ELSE 6 END))) AS INTEGER)*1000000000 + CAST(substr((CASE WHEN instr(captured_at,'.')>0 THEN substr(captured_at,instr(captured_at,'.')+1,length(captured_at)-instr(captured_at,'.')-(CASE WHEN substr(captured_at,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9) AS INTEGER)), CAST(id AS TEXT))
index idx_operator_labels_agent_pattern: CREATE INDEX idx_operator_labels_agent_pattern ON operator_labels(agent, pattern)
index idx_operator_labels_rule: CREATE INDEX idx_operator_labels_rule ON operator_labels(rule)
index idx_resource_episodes_captured_at: CREATE INDEX idx_resource_episodes_captured_at ON resource_episodes(captured_at)
index idx_resource_episodes_session_at: CREATE INDEX idx_resource_episodes_session_at ON resource_episodes(session_id, captured_at, id)
index idx_rollup_hourly_bucket: CREATE INDEX idx_rollup_hourly_bucket ON rollup_hourly(bucket)
index idx_sessions_activity: CREATE INDEX idx_sessions_activity ON sessions(status, (strftime('%Y-%m-%dT%H:%M:%S',substr(last_seen_at,1,19)||substr(last_seen_at,-(CASE WHEN substr(last_seen_at,-1)='Z' THEN 1 ELSE 6 END)))||'.'||substr((CASE WHEN instr(last_seen_at,'.')>0 THEN substr(last_seen_at,instr(last_seen_at,'.')+1,length(last_seen_at)-instr(last_seen_at,'.')-(CASE WHEN substr(last_seen_at,-1)='Z' THEN 1 ELSE 6 END)) ELSE '' END)||'000000000',1,9)||'Z') DESC, id DESC)
index idx_sessions_root_identity: CREATE INDEX idx_sessions_root_identity ON sessions(root_pid, root_started_at)
index idx_sessions_status: CREATE INDEX idx_sessions_status ON sessions(status, last_seen_at)
table advisor_plans: created_at TEXT notnull=0 default=; plan_json TEXT notnull=0 default=; subject_id TEXT notnull=0 default=
table advisor_verdicts: assessment TEXT notnull=0 default=; confidence REAL notnull=0 default=; created_at TEXT notnull=0 default=; kind TEXT notnull=0 default=; model TEXT notnull=0 default=; rationale TEXT notnull=0 default=; subject_id TEXT notnull=0 default=; suggested_action TEXT notnull=0 default=
table agent_asks: cost_usd REAL notnull=0 default=; detail TEXT notnull=0 default=; finished_at TEXT notnull=0 default=; harness TEXT notnull=1 default=; id INTEGER notnull=0 default=; output TEXT notnull=0 default=; path TEXT notnull=1 default=; repo TEXT notnull=0 default=; session_id TEXT notnull=1 default=; status TEXT notnull=1 default=; ts TEXT notnull=1 default=; verdict TEXT notnull=0 default=
table audit: action TEXT notnull=0 default=; detail TEXT notnull=0 default=; from_mode TEXT notnull=0 default=; id INTEGER notnull=0 default=; rule TEXT notnull=0 default=; to_mode TEXT notnull=0 default=; ts TEXT notnull=0 default=
table cleanup_log: action TEXT notnull=1 default=; bytes INTEGER notnull=1 default=0; detail TEXT notnull=0 default=; id INTEGER notnull=0 default=; path TEXT notnull=1 default=; repo TEXT notnull=0 default=; ts TEXT notnull=1 default=
table decision_scope_receipts: choice_json TEXT notnull=1 default=; ids_json TEXT notnull=1 default=; review_id TEXT notnull=1 default=; revision INTEGER notnull=1 default=
table decision_scopes: agent TEXT notnull=1 default=; id TEXT notnull=0 default=; operation TEXT notnull=1 default=; record_json TEXT notnull=1 default=; rule_id TEXT notnull=1 default=
table egress_episodes: agent TEXT notnull=1 default=; count INTEGER notnull=1 default=; exe_path TEXT notnull=1 default=; first_seen_ns INTEGER notnull=1 default=; harness TEXT notnull=1 default=; host TEXT notnull=1 default=; id TEXT notnull=0 default=; intervals_json TEXT notnull=1 default=; last_seen_ns INTEGER notnull=1 default=; port INTEGER notnull=1 default=; protocol TEXT notnull=1 default=; session_ids_json TEXT notnull=1 default=; workspace TEXT notnull=1 default=
table events: call_id TEXT notnull=0 default=; cost_usd REAL notnull=0 default=; detail TEXT notnull=0 default=; duration_ms INTEGER notnull=0 default=; exe_path TEXT notnull=0 default=; id INTEGER notnull=0 default=; kind INT notnull=0 default=; model TEXT notnull=0 default=; path TEXT notnull=0 default=; pid INT notnull=0 default=; provider TEXT notnull=0 default=; record INTEGER notnull=1 default=0; remote_host TEXT notnull=0 default=; remote_port INT notnull=0 default=; session_id TEXT notnull=0 default=; tokens_in INTEGER notnull=0 default=; tokens_out INTEGER notnull=0 default=; tool TEXT notnull=0 default=; tool_status TEXT notnull=0 default=; ts TEXT notnull=0 default=
table expected_egress_rules: agent TEXT notnull=1 default=; created_at TEXT notnull=1 default=; created_by TEXT notnull=1 default=; exe_path TEXT notnull=1 default=; harness TEXT notnull=1 default=; host TEXT notnull=1 default=; id TEXT notnull=0 default=; kind TEXT notnull=1 default=; port INTEGER notnull=1 default=; protocol TEXT notnull=1 default=; rationale TEXT notnull=1 default=; revoked_at TEXT notnull=0 default=; workspace TEXT notnull=1 default=
table finding_review_actions: action TEXT notnull=1 default=; at TEXT notnull=1 default=; review_id TEXT notnull=1 default=; revision INTEGER notnull=1 default=
table finding_review_members: count INTEGER notnull=1 default=; flag_id TEXT notnull=0 default=; last_seen TEXT notnull=1 default=; review_id TEXT notnull=1 default=; source_key TEXT notnull=1 default=
table finding_reviews: closed_at TEXT notnull=0 default=; context_key TEXT notnull=1 default=; id TEXT notnull=0 default=; last_seen TEXT notnull=1 default=; record_json TEXT notnull=1 default=; session_id TEXT notnull=1 default=; state TEXT notnull=1 default=
table flags: ack_reason TEXT notnull=0 default=; acknowledged TEXT notnull=0 default=; agent TEXT notnull=0 default=; evidence TEXT notnull=0 default=; id TEXT notnull=0 default=; last_seen TEXT notnull=0 default=; pid INT notnull=0 default=; process TEXT notnull=0 default=; repeats INTEGER notnull=0 default=; rule TEXT notnull=0 default=; session_id TEXT notnull=0 default=; severity INT notnull=0 default=; ts TEXT notnull=0 default=; workspace TEXT notnull=0 default=
table guard_decisions: at TEXT notnull=1 default=; id TEXT notnull=0 default=; receipt_json TEXT notnull=1 default='{}'; rule_id TEXT notnull=1 default=; scope TEXT notnull=1 default=; session_id TEXT notnull=1 default=; verdict TEXT notnull=1 default=
table guard_path_allows: agent TEXT notnull=1 default=; created_at TEXT notnull=0 default=; path TEXT notnull=1 default=; rule_id TEXT notnull=1 default=
table guard_rules: agent TEXT notnull=1 default=; created_at TEXT notnull=0 default=; decision TEXT notnull=1 default=; rule_id TEXT notnull=1 default=; source TEXT notnull=0 default=
table hook_runs: chars INTEGER notnull=1 default=0; duration_ms INTEGER notnull=1 default=0; evidence_json TEXT notnull=1 default='{}'; harness TEXT notnull=1 default=''; hook TEXT notnull=1 default=; id INTEGER notnull=0 default=; run_id TEXT notnull=1 default=; script TEXT notnull=1 default=; session_id TEXT notnull=1 default=; status TEXT notnull=1 default=; ts TEXT notnull=1 default=
table incidents: acknowledged_at TEXT notnull=0 default=; aggregate_count INTEGER notnull=0 default=; created_at TEXT notnull=0 default=; flag_id TEXT notnull=0 default=; flag_ids TEXT notnull=0 default=; id TEXT notnull=0 default=; last_flag_at TEXT notnull=0 default=; pid INT notnull=0 default=; remediation_json TEXT notnull=0 default=; report_json TEXT notnull=0 default=; resolution_note TEXT notnull=0 default=; resolved_at TEXT notnull=0 default=; risk TEXT notnull=0 default=; rule TEXT notnull=0 default=; session_id TEXT notnull=0 default=; status TEXT notnull=0 default='open'; subject TEXT notnull=0 default=
table interventions: id TEXT notnull=0 default=; receipt_json TEXT notnull=1 default=; requested_at TEXT notnull=1 default=; revision INTEGER notnull=1 default=; session_id TEXT notnull=1 default=''; session_key TEXT notnull=1 default=
table operator_labels: agent TEXT notnull=0 default=; created_at TEXT notnull=0 default=; id INTEGER notnull=0 default=; kind TEXT notnull=0 default=; label TEXT notnull=0 default=; pattern TEXT notnull=0 default=; reason TEXT notnull=0 default=; rule TEXT notnull=0 default=; source TEXT notnull=0 default=
table resource_episodes: captured_at TEXT notnull=1 default=; episode_json TEXT notnull=1 default=; id INTEGER notnull=0 default=; session_id TEXT notnull=0 default=; session_key TEXT notnull=1 default=; severity TEXT notnull=1 default=
table rollup_hourly: bucket TEXT notnull=1 default=; count INT notnull=1 default=; kind TEXT notnull=1 default=
table scan_cache: body BLOB notnull=1 default=; name TEXT notnull=0 default=; saved_at TEXT notnull=1 default=
table sessions: branch TEXT notnull=0 default=; confidence TEXT notnull=0 default=; ended_at TEXT notnull=0 default=; harness TEXT notnull=0 default=; id TEXT notnull=0 default=; last_seen_at TEXT notnull=0 default=; origin TEXT notnull=0 default=; parent_id TEXT notnull=0 default=; repo TEXT notnull=0 default=; root_pid INTEGER notnull=0 default=; root_started_at TEXT notnull=0 default=; started_at TEXT notnull=0 default=; status TEXT notnull=0 default=; workspace TEXT notnull=0 default=
table shell_reviews: at TEXT notnull=1 default=; id INTEGER notnull=0 default=; result_json TEXT notnull=1 default=
table sysagent_messages: body TEXT notnull=1 default=; id INTEGER notnull=0 default=; ts TEXT notnull=1 default=
table sysagent_plans: body TEXT notnull=1 default=; id INTEGER notnull=0 default=; ts TEXT notnull=1 default=
table sysagent_runs: body TEXT notnull=1 default=; id INTEGER notnull=0 default=; ts TEXT notnull=1 default=
table worktree_repos: first_seen TEXT notnull=1 default=; hidden INTEGER notnull=1 default=0; last_scan TEXT notnull=0 default=; path TEXT notnull=0 default=; source TEXT notnull=1 default=
